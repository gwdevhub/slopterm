<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Slopterm.Mobile</RootNamespace>

    <!-- Permanent once published to Google Play - it can never be changed for this listing. -->
    <ApplicationId>com.gwdevhub.slopterm</ApplicationId>

    <!--
      $(ApplicationVersion) (versionCode) and $(ApplicationDisplayVersion) (versionName) are
      derived from the repo-root VERSION file by Directory.Build.props - see the formula and its
      bounds there. Don't set them here; that would silently win over the computed values.

      Release builds produce both an .aab and an .apk ($(AndroidPackageFormats) defaults to
      'aab;apk' for Release): the .aab is what Google Play takes, the .apk is what gets attached
      to the GitHub release for sideloading.
    -->

    <!-- EXPERIMENT: ASP.NET Core has no *runtime pack* for android RIDs (NETSDK1082), but the
         base .NET runtime does ship for android and the ASP.NET Core assemblies are portable
         managed IL. So: don't inherit Core's Microsoft.AspNetCore.App framework reference
         (which would demand the missing android runtime pack), and instead inject the ASP.NET
         Core implementation assemblies from the desktop (linux-x64) runtime pack below. They
         should JIT from their IL on the android runtime (R2R native is arch-specific and just
         falls back to IL). Whether Kestrel then actually RUNS on-device is the next question. -->
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    <_AspNetCoreRuntimePackVersion>10.0.10</_AspNetCoreRuntimePackVersion>
  </PropertyGroup>

  <!--
    R8 - the "enable app optimization" Play Console recommends. It shrinks and optimises the
    JAVA/dex side only (the Mono runtime's Java classes, the Android Callable Wrappers generated
    for our [Activity]/[Service] types, androidx); it does NOT touch managed IL, so it is
    unrelated to $(PublishTrimmed)/$(AndroidLinkMode), which stay off - see AGENTS.md, trimming
    breaks SSH.NET's reflection.

    Keep rules come from the SDK: proguard_xamarin.cfg plus the generated
    obj/**/proguard_project_references.cfg, which keeps every type that has an ACW, so the
    classes the runtime looks up by name over JNI survive; proguard.cfg adds the one rule they
    miss (the R classes, which only the managed side reads).

    proguard_xamarin.cfg also sets -dontobfuscate, so this is a shrink/optimise pass with no
    renaming. R8 still writes bin/Release/net10.0-android/mapping.txt and the .aab carries it in
    BUNDLE-METADATA/com.android.tools.build.obfuscation/proguard.map, which is the deobfuscation
    file Play asks for - no separate upload step needed.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidLinkTool>r8</AndroidLinkTool>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <ProguardConfiguration Include="proguard.cfg" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../core/Slopterm.Core.csproj" />
    <!-- Pull the linux-x64 ASP.NET Core runtime pack into the NuGet cache so we can borrow its
         assemblies (we never target linux - we only want the portable IL bodies). -->
    <PackageDownload Include="Microsoft.AspNetCore.App.Runtime.linux-x64" Version="[$(_AspNetCoreRuntimePackVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <!-- Android app icon - included in all drawable density folders -->
    <AndroidResource Include="Resources\drawable\ic_launcher.png" />
    <AndroidResource Include="Resources\drawable-hdpi\ic_launcher.png" />
    <AndroidResource Include="Resources\drawable-mdpi\ic_launcher.png" />
    <AndroidResource Include="Resources\drawable-xhdpi\ic_launcher.png" />
    <AndroidResource Include="Resources\drawable-xxhdpi\ic_launcher.png" />
    <AndroidResource Include="Resources\drawable-xxxhdpi\ic_launcher.png" />
  </ItemGroup>

  <Target Name="_InjectAspNetCoreAssemblies" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Include="$(NuGetPackageRoot)microsoft.aspnetcore.app.runtime.linux-x64/$(_AspNetCoreRuntimePackVersion)/runtimes/linux-x64/lib/net10.0/*.dll">
        <Private>true</Private>
      </Reference>
    </ItemGroup>
  </Target>

</Project>
