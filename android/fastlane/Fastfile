# frozen_string_literal: true

# Uploads the Android App Bundle produced by `dotnet publish -c Release -f net10.0-android`
# to Google Play. Driven by .github/workflows/versioned-release.yml; runnable locally too
# (see README.md). Google Play does not accept an .apk for a new app - the .aab is the only
# artifact that can be uploaded here, so nothing in this file touches the .apk.

default_platform(:android)

# Anchored to THIS FILE's directory, never to the working directory. fastlane runs lanes with the
# cwd set to the parent of fastlane/, so a bare relative path here does not mean what it looks
# like it means - a relative json_key_file("service-account.json") in the Appfile resolves to
# android/service-account.json and fails with "Invalid default value for json_key". Found the
# hard way; don't reintroduce cwd-relative paths.
def android_output_dir
  File.expand_path("../bin/Release/net10.0-android", __dir__)
end

def service_account_json
  ENV["SUPPLY_JSON_KEY"] || File.expand_path("service-account.json", __dir__)
end

# The signed bundle is emitted as *-Signed.aab alongside the raw one; prefer it, and fall back to
# any .aab so a locally-built unsigned bundle still gives a clear error from Play rather than a
# confusing "no bundle found" here. Recursive, because `dotnet publish` puts its copy in publish/.
def resolve_aab(options)
  explicit = options[:aab] || ENV["SUPPLY_AAB"]
  return explicit unless explicit.nil? || explicit.empty?

  candidates = Dir.glob("#{android_output_dir}/**/*.aab")
  candidates.find { |f| f.end_with?("-Signed.aab") } || candidates.max_by { |f| File.mtime(f) }
end

def upload_bundle(options, default_track)
  aab = resolve_aab(options)
  if aab.nil? || !File.exist?(aab)
    UI.user_error!("No .aab found under #{android_output_dir}. Run `dotnet publish -c Release -f net10.0-android` from android/ first, or pass aab:<path>.")
  end

  track = options[:track] || ENV["SLOPTERM_PLAY_TRACK"] || default_track
  # 'draft' uploads the release without rolling it out - the other valid values are 'completed',
  # 'inProgress' and 'halted'. Draft is the default on purpose: a bad build should need a human
  # click in the Play Console before it reaches anyone.
  status = options[:release_status] || ENV["SLOPTERM_PLAY_RELEASE_STATUS"] || "draft"

  # Dry run: supply uploads into a Play edit and asks Google to validate it, then throws the edit
  # away instead of committing. Nothing is published. `fastlane android internal validate_only:true`
  # is the way to prove credentials/package/bundle all line up without spending a versionCode.
  dry_run = (options[:validate_only] || ENV["SLOPTERM_PLAY_VALIDATE_ONLY"]).to_s == "true"

  UI.message("Uploading #{File.basename(aab)} to the '#{track}' track (release_status: #{status}#{dry_run ? ', VALIDATE ONLY' : ''})")

  upload_to_play_store(
    aab: File.expand_path(aab),
    json_key: service_account_json,
    track: track,
    release_status: status,
    validate_only: dry_run,
    # The store listing (title, description, screenshots, changelogs) is maintained by hand in
    # the Play Console - this repo has no fastlane metadata/ tree to upload from, and without
    # these skips supply would try to read one and fail.
    skip_upload_metadata: true,
    skip_upload_images: true,
    skip_upload_screenshots: true,
    skip_upload_changelogs: true
  )

  UI.success("Uploaded to Google Play ('#{track}' track, #{status}).")
end

platform :android do
  desc "Upload the release .aab to Google Play (production track by default)"
  lane :release do |options|
    upload_bundle(options, "production")
  end

  desc "Upload the release .aab to the Google Play internal testing track"
  lane :internal do |options|
    upload_bundle(options, "internal")
  end

  desc "Upload the release .aab to the Google Play beta (open/closed testing) track"
  lane :beta do |options|
    upload_bundle(options, "beta")
  end
end
