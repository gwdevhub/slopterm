# frozen_string_literal: true

# supply reads `package_name` here - NOT `app_identifier`, which is the iOS key and has no
# fallback to this one in fastlane's CredentialsManager. Must match $(ApplicationId) in
# Slopterm.Android.csproj, and it is permanent once the app is published.
package_name("com.gwdevhub.slopterm")

# Google Play API service account key, resolved relative to this fastlane/ directory. Used for
# local runs; CI writes the key outside the checkout and points SUPPLY_JSON_KEY at it instead
# (an explicit env var wins over this default).
json_key_file("service-account.json")
