# frozen_string_literal: true

source "https://rubygems.org"

gem "fastlane", "~> 2.215"

# fastlane writes its plugin list to Pluginfile when `fastlane add_plugin` is used; there are no
# plugins today, so the file doesn't exist and this is a no-op until one is added.
plugins_path = File.join(File.dirname(__FILE__), "Pluginfile")
eval_gemfile(plugins_path) if File.exist?(plugins_path)
