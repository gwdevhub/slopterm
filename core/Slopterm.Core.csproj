<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The Web SDK gives us ASP.NET Core + its implicit usings, but defaults to producing
         an executable; this is a library the head drives (SloptermHost.Start), so force it. -->
    <OutputType>Library</OutputType>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The React build is embedded into THIS assembly (SloptermHost serves it via a
         ManifestEmbeddedFileProvider over GetExecutingAssembly()), so it travels with Core
         to whichever head hosts it - desktop today, Android later. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core (Kestrel + minimal APIs) as a framework reference, so this stays a
         plain library rather than a web *app* with its own entry point - the head owns the
         entry point and calls SloptermHost.Start. -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="SSH.NET" Version="2025.1.0" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.10" />
    <!-- Cron expressions for scheduled jobs (SchedulerService). A hand-rolled parser was the
         original plan, but the DST rules alone (a nightly job whose local time doesn't exist
         on the spring-forward day, or happens twice in autumn) are exactly the kind of thing
         a widely-used implementation has already settled. Small, no transitive dependencies,
         netstandard2.0 so the Android head takes it too. -->
    <PackageReference Include="Cronos" Version="0.13.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot/**" />
    <EmbeddedResource Include="wwwroot/**" />
  </ItemGroup>

</Project>
