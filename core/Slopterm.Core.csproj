<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The Web SDK gives us ASP.NET Core + its implicit usings, but defaults to producing
         an executable; this is a library the head drives (SloptermHost.Start), so force it. -->
    <OutputType>Library</OutputType>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The React build is embedded into THIS assembly (SloptermHost serves it via a
         ManifestEmbeddedFileProvider over GetExecutingAssembly()), so it travels with Core
         to whichever head hosts it - desktop today, Android later. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core (Kestrel + minimal APIs) as a framework reference, so this stays a
         plain library rather than a web *app* with its own entry point - the head owns the
         entry point and calls SloptermHost.Start. -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <!-- X25519/Ed25519 for vault sync (see CollectionCrypto). Already in the publish output
         transitively via SSH.NET, but referenced directly so an SSH.NET release that drops
         it can't silently break collection crypto. The BCL's ECDiffieHellman/ECDsa are not
         an option: Wine can't generate ECDH keys at all, and the repo's mandatory
         verification pass runs the win-x64 build under Wine. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="SSH.NET" Version="2025.1.0" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot/**" />
    <EmbeddedResource Include="wwwroot/**" />
  </ItemGroup>

</Project>
