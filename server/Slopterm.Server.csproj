<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- No console window on the published Windows build - the system tray icon is the
         only UI (see Native/WindowsTrayIcon.cs and Program.cs). Only applies when actually
         publishing for win-x64; plain `dotnet run`/`dotnet build` (no -r) stays a normal
         console app on every OS for local development. -->
    <OutputType Condition="'$(RuntimeIdentifier)' == 'win-x64'">WinExe</OutputType>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Single-file bundling normally excludes managed assemblies it decides nothing
         reachable references - System.IO.Pipes is one of those, but Process.Start
         (UpdateService's self-update relaunch) needs it internally on Unix regardless
         (an internal pipe-based child-exit watcher). This also guarantees Slopterm.Core -
         which carries the embedded React app - and its manifest resources are bundled in. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <!-- Compresses the bundled assemblies inside the single-file exe (~51% smaller,
         self-extracts to a temp dir at first run). Do NOT also add PublishTrimmed here:
         it breaks every endpoint outright (System.Text.Json can't resolve ConnectRequest's
         type metadata once reflection-based JSON is trimmed), and SSH.NET isn't
         trim-annotated so the trimmer can silently strip its internals with no warning -
         see AGENTS.md's Distribution constraints section. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- We self-host via Kestrel only; suppress the IIS-hosting web.config this SDK
         otherwise generates, since it implies a deployment model we don't support. -->
    <IsWebConfigTransformDisabled>true</IsWebConfigTransformDisabled>
    <!-- Sets the .exe's own Win32 icon resource (Explorer/taskbar/file properties) -
         distinct from Native/app.ico's use as an embedded resource that
         WindowsTrayIcon/AppWindowManager load at runtime for the tray/window icon. Same
         source file; only takes effect on a real win-x64 PE, ignored elsewhere. -->
    <ApplicationIcon>Native/app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The host-agnostic backend (Kestrel + endpoints + vault/ssh/sftp/forwarding/sync +
         the embedded React app) - shared with any future non-desktop head (Android). This
         desktop project is just the Photino window + Windows tray shell around it. -->
    <ProjectReference Include="../core/Slopterm.Core.csproj" />
    <!-- 3.2.3's Linux native build links webkit2gtk 4.0 specifically, which modern
         distros (this one included) no longer ship at all - only 4.0.16+ links 4.1. -->
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

  <ItemGroup>
    <!-- app.ico/app.png are the native window/tray icons (see WindowsTrayIcon.cs's
         LoadAppIcon and AppWindowManager's use of EmbeddedIcon), embedded in THIS desktop
         assembly since only the desktop shell uses them. app.png exists because GTK's icon
         loader (Photino's window icon on Linux) rejects app.ico's PNG-compressed entries;
         Win32's LoadImage handles that format fine, so app.ico stays Windows-only. -->
    <Content Remove="Native/app.ico" />
    <EmbeddedResource Include="Native/app.ico" />
    <Content Remove="Native/app.png" />
    <EmbeddedResource Include="Native/app.png" />
  </ItemGroup>

</Project>
